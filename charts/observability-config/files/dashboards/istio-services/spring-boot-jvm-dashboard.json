{
 "id": null,
 "uid": "spring-boot-jvm",
 "title": "Spring Boot Backend (JVM & HTTP)",
 "tags": [
  "spring-boot",
  "jvm",
  "backend"
 ],
 "timezone": "",
 "schemaVersion": 38,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "service",
    "type": "query",
    "label": "Service",
    "query": "label_values(jvm_memory_used_bytes{namespace=\"apps\"}, app)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".+"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "HTTP request rate",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_requests_seconds_count{app=~\"$service\"}[5m])) by (app, status)",
     "legendFormat": "{{app}} [{{status}}]"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "HTTP request duration (average)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_requests_seconds_sum{app=~\"$service\", uri!~\"/actuator.*\"}[5m])) by (app, uri) / sum(rate(http_server_requests_seconds_count{app=~\"$service\", uri!~\"/actuator.*\"}[5m])) by (app, uri)",
     "legendFormat": "{{app}} {{uri}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "JVM heap used",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(jvm_memory_used_bytes{area=\"heap\", app=~\"$service\"}) by (app)",
     "legendFormat": "{{app}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "JVM GC pause time",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(jvm_gc_pause_seconds_sum{app=~\"$service\"}[5m])) by (app)",
     "legendFormat": "{{app}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Process CPU usage",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "max": 1,
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg(process_cpu_usage{app=~\"$service\"}) by (app)",
     "legendFormat": "{{app}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "HikariCP active connections",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(hikaricp_connections_active{app=~\"$service\"}) by (app)",
     "legendFormat": "{{app}} active"
    },
    {
     "refId": "B",
     "expr": "sum(hikaricp_connections_pending{app=~\"$service\"}) by (app)",
     "legendFormat": "{{app}} pending"
    }
   ]
  }
 ]
}